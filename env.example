# Скопируйте в .env и заполните. .env НЕ отправляйте никому и не заливайте в git.
BOT_TOKEN=токен_от_BotFather
CRYPTO_BOT_TOKEN=токен_из_CryptoBot_Crypto_Pay_My_Apps
ADMIN_IDS=123456789

# ПУБЛИЧНЫЙ https-адрес проекта (тот же домен, что в Caddyfile / выданный Railway/Render).
# Бот сам отдаёт по нему и мини-апп, и API — Netlify больше не нужен.
SHOP_WEBAPP_URL=https://shop.example.com

WEBAPI_ENABLED=true
WEBAPI_PORT=8080

# Необязательно
# SUPPORT_LINK=t.me/StarlifyAdmin
# CRYPTO_BOT_TESTNET=false
# DONATE_TON_ADDRESS=
# DONATE_USDT_ADDRESS=

# --- Бесплатные хостинги (Render и т.п.) ---
# KEEPALIVE=true      бот сам пингует свой адрес, чтобы хостинг не усыплял его
# BACKUP_HOURS=1      как часто присылать админу копию базы в Telegram (0 = выключить)
# PAYMENT_WATCH_SECONDS=45   как часто фоном проверять оплату CryptoBot

# --- Реквизиты и витрина (применяются при каждом старте, переживают очистку базы) ---
# CARD_NUMBER=5375 4141 0000 0000
# CARD_NAME=IVAN IVANOV
# HIDE_SECTIONS=nft            # скрыть разделы Mini App: stars,premium,ton,nft,reviews,channel,support
# STARS_RATE=0.77              # цена 1 звезды, грн
# PREMIUM_3M=450  PREMIUM_6M=800  PREMIUM_1Y=1500
